{
    "name": "telegram-monitor/app",
    "description": "Telegram Monitor - система мониторинга публичных Telegram-групп",
    "type": "project",
    "require": {
        "php": ">=8.4",
        "yiisoft/yii2": "~2.0.49",
        "yiisoft/yii2-bootstrap4": "~2.0.0",
        "yiisoft/yii2-swiftmailer": "~2.1.0",
        "danog/madelineproto": "^8.0",
        "yiisoft/yii2-queue": "~2.3.0",
        "yiisoft/yii2-redis": "~2.0.0",
        "almasaeed2010/adminlte": "~3.2"
    },
    "require-dev": {
        "yiisoft/yii2-debug": "~2.1.0",
        "yiisoft/yii2-gii": "~2.2.0",
        "yiisoft/yii2-faker": "~2.0.0",
        "codeception/codeception": "^5.0.0",
        "codeception/verify": "~3.0.0"
    },
    "config": {
        "process-timeout": 1800,
        "allow-plugins": {
            "yiisoft/yii2-composer": true
        }
    },
    "autoload": {
        "psr-4": {
            "app\\": "src/"
        }
    },
    "repositories": [
        {
            "type": "composer",
            "url": "https://asset-packagist.org"
        }
    ]
}
